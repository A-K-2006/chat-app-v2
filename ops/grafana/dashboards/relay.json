{
  "uid": "relay-overview",
  "title": "Relay — Distributed Chat Overview",
  "tags": ["relay", "chat", "kafka"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Active WebSocket connections (per instance)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "ws_connections_active", "legendFormat": "{{instance}}", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "Message throughput (sent / delivered per s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(messages_sent_total[1m]))", "legendFormat": "sent/s", "refId": "A" },
        { "expr": "sum(rate(messages_delivered_total[1m]))", "legendFormat": "delivered/s", "refId": "B" },
        { "expr": "sum(rate(history_messages_persisted_total[1m]))", "legendFormat": "persisted/s", "refId": "C" }
      ]
    },
    {
      "id": 3,
      "title": "End-to-end delivery latency (percentiles)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "message_e2e_latency_seconds{quantile=\"0.5\"}", "legendFormat": "p50", "refId": "A" },
        { "expr": "message_e2e_latency_seconds{quantile=\"0.95\"}", "legendFormat": "p95", "refId": "B" },
        { "expr": "message_e2e_latency_seconds{quantile=\"0.99\"}", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "id": 4,
      "title": "Kafka consumer broker lag (max records)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "kafka_consumer_fetch_manager_records_lag_max", "legendFormat": "{{client_id}}", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "title": "Rate-limit rejections / s",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(rate_limit_rejected_total[1m]))", "legendFormat": "rejected/s", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "title": "Outbox pending (unpublished rows)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "outbox_pending", "legendFormat": "{{service}}", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "title": "Dedup hits / s (idempotent replays)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(history_dedup_hits_total[1m]))", "legendFormat": "dedup/s", "refId": "A" }
      ]
    },
    {
      "id": 8,
      "title": "JVM heap used (per service)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "expr": "sum by (service) (jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "{{service}}", "refId": "A" }
      ]
    },
    {
      "id": 9,
      "title": "Process CPU usage (per service)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        { "expr": "process_cpu_usage", "legendFormat": "{{service}}", "refId": "A" }
      ]
    },
    {
      "id": 10,
      "title": "HTTP server request rate (per service)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "expr": "sum by (service) (rate(http_server_requests_seconds_count[1m]))", "legendFormat": "{{service}}", "refId": "A" }
      ]
    }
  ]
}
